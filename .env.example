UBER_CLIENT_SECRET=

# ==============================================================================
# CONNECTORS — Health, Fitness & Lifestyle
# ==============================================================================

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_ACCESS_TOKEN=

# ==============================================================================
# CONNECTORS — Travel & Other
# ==============================================================================

SKYSCANNER_RAPIDAPI_KEY=
AIRBNB_ACCESS_TOKEN=

# ==============================================================================
# CONNECTORS — Learning & Knowledge
# ==============================================================================

EDX_CLIENT_ID=
EDX_CLIENT_SECRET=
NOTEBOOKLM_GOOGLE_TOKEN=

# ==============================================================================
# CONNECTORS — Contacts & Calendar
# ==============================================================================

GOOGLE_CONTACTS_TOKEN=
CALENDAR_CALDAV_URL=
CALENDAR_USERNAME=
CALENDAR_PASSWORD=
GOOGLE_CALENDAR_ID=primary

# ==============================================================================
# INTEGRATIONS
# ==============================================================================

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Telegram briefings (separate from connector)
TELEGRAM_REPORT_CHAT_ID=

# Google Analytics
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Weather
OPENWEATHER_API_KEY=

# ==============================================================================
# CONNECTORS — X (Twitter)
# ==============================================================================

X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ==============================================================================
# CONNECTORS — Video & News
# ==============================================================================

YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PRODUCTHUNT_TOKEN=

# ==============================================================================
# CONNECTORS — BambuLab 3D Printer
# ==============================================================================

BAMBULAB_EMAIL=
BAMBULAB_PASSWORD=
BAMBULAB_PRINTER_IP=

# ==============================================================================
# CONNECTORS — Other
# ==============================================================================

SISAL_SESSION_TOKEN=
OOPBUY_SESSION=
FARFETCH_SESSION_COOKIE=
STRAVA_ACCESS_TOKEN=                   # short-lived; use refresh token above

# MetaTrader bridge (needs local MT4/MT5 EA running)
MT_HOST=127.0.0.1
MT_PORT=8001
MT_SERVER=
MT_LOGIN=
MT_PASSWORD=

# Google OAuth tokens (Calendar, Contacts, Gmail)
GOOGLE_ACCESS_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CONTACTS_ACCESS_TOKEN=
GMAIL_ACCESS_TOKEN=

# EdX LMS
EDX_USERNAME=
EDX_ACCESS_TOKEN=

# ==============================================================================
# MODEL PROVIDERS (optional — Anthropic is primary)
# Activate each provider by setting its key. All degrade gracefully when absent.
# ==============================================================================

OPENAI_API_KEY=sk-...                  # for OpenAI GPT-4o / GPT-4o-mini (cloud fallback)
GEMINI_API_KEY=                        # for Google Gemini 1.5 Pro/Flash (cloud fallback)
PERPLEXITY_API_KEY=pplx-...           # for Perplexity Sonar (web-augmented search tasks)

# ==============================================================================
# OFFLINE / LOCAL MODEL (for local_offline and survival modes)
# ==============================================================================

# Ollama endpoint (if running locally — powers Qwen and local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# ==============================================================================
# WEB SERVER (optional)
# ==============================================================================

# Comma-separated allowed origins for CORS (defaults to localhost:8080 only)
SOVEREIGN_ALLOWED_ORIGINS=

# Set to "production" to enforce strict secret validation on startup
SOVEREIGN_ENV=
