# SOVEREIGN AI OS — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ==============================================================================
# REQUIRED
# ==============================================================================

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==============================================================================
# SECURITY (set ALL of these before exposing to the internet)
# ==============================================================================

SOVEREIGN_PASSWORD=change_this_strong_password
AUTH_SECRET_KEY=change_this_to_a_random_64_char_string
SECRET_MANAGER_KEY=change_this_to_a_random_key_for_vault_encryption

# ==============================================================================
# RUNTIME (optional — defaults in config/sovereign.yaml)
# ==============================================================================

SOVEREIGN_LOG_LEVEL=INFO
SOVEREIGN_DATA_DIR=data
SOVEREIGN_APPROVAL_MODE=cli
SOVEREIGN_DEFAULT_MODEL=claude-sonnet-4-6
SOVEREIGN_CONFIG=config/sovereign.yaml

# ==============================================================================
# CONNECTORS — Finance & Trading
# ==============================================================================

BINANCE_API_KEY=
