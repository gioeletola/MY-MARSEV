# SOVEREIGN AI OS — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ==============================================================================
# REQUIRED
# ==============================================================================

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==============================================================================
# SECURITY (set ALL of these before exposing to the internet)
# ==============================================================================

SOVEREIGN_PASSWORD=change_this_strong_password
AUTH_SECRET_KEY=change_this_to_a_random_64_char_string
SECRET_MANAGER_KEY=change_this_to_a_random_key_for_vault_encryption

# ==============================================================================
# RUNTIME (optional — defaults in config/sovereign.yaml)
# ==============================================================================

SOVEREIGN_LOG_LEVEL=INFO
SOVEREIGN_DATA_DIR=data
SOVEREIGN_APPROVAL_MODE=cli
SOVEREIGN_DEFAULT_MODEL=claude-sonnet-4-6
SOVEREIGN_CONFIG=config/sovereign.yaml

# ==============================================================================
# CONNECTORS — Finance & Trading
# ==============================================================================

BINANCE_API_KEY=
BINANCE_API_SECRET=
STRIPE_SECRET_KEY=sk_live_...
REVOLUT_API_KEY=
ETORO_API_KEY=
METATRADER_BRIDGE_URL=http://localhost:5001
COINGECKO_API_KEY=                            # optional — free tier works without key

# ==============================================================================
# CONNECTORS — Communication & Social
# ==============================================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_BOT_TOKEN=xoxb-...
DISCORD_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
LINKEDIN_ACCESS_TOKEN=

# ==============================================================================
# CONNECTORS — Productivity & Organization
# ==============================================================================

NOTION_TOKEN=secret_...
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
LINEAR_API_KEY=lin_api_...
GITHUB_TOKEN=ghp_...
CALENDLY_API_KEY=
TYPEFORM_API_KEY=
MAILCHIMP_API_KEY=xxxxxxxxxxxx-us1

# ==============================================================================
