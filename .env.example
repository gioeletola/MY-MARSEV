# SOVEREIGN AI OS — Environment Variables
# Copy this file to .env and fill in your values.

# Required: Anthropic API key
ANTHROPIC_API_KEY=your_api_key_here

# Optional overrides (defaults come from config/sovereign.yaml)
SOVEREIGN_LOG_LEVEL=INFO
SOVEREIGN_DATA_DIR=data
SOVEREIGN_APPROVAL_MODE=cli
SOVEREIGN_DEFAULT_MODEL=claude-sonnet-4-6
